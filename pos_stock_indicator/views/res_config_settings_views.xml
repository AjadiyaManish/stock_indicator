<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos_product_stock_indicator</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_interface_section']" position="inside">
                <setting id="show_product_stock_setting" string="Show Product Stock in POS" help="Displays the real-time stock quantity natively on the product card within the POS interface.">
                    <field name="pos_show_product_stock"/>
                    <div class="content-group" invisible="not pos_show_product_stock">
                        <div class="mt16">
                            <label for="pos_low_stock_threshold" string="Low Stock Threshold" class="o_light_label"/>
                            <field name="pos_low_stock_threshold" class="oe_inline"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
