<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_product_stock_indicator.FuturePOScreen">
        <div class="ticket-screen screen h-100 bg-100">
            <div class="screen-full-width d-flex w-100 h-100">
                <div class="rightpane pane-border d-flex flex-column flex-grow-1 w-100 h-100 h-lg-100 pe-lg-0 bg-view border-end overflow-y-auto">
                    <div class="controls p-3 border-bottom d-flex align-items-center gap-3">
                        <button class="btn btn-lg btn-secondary" t-on-click="onBack">
                            <i class="fa fa-chevron-left me-1"/> Back
                        </button>
                        <h4 class="mb-0">Future Received Product List</h4>
                    </div>
                    <div class="orders overflow-y-auto flex-grow-1">
                        <table class="table table-striped table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Product Name</th>
                                    <th>PO Ref Num</th>
                                    <th>Vendor Name</th>
                                    <th class="text-end">Qty</th>
                                    <th class="text-end">Expected Arrival</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="state.orders" t-as="line" t-key="line.id">
                                    <tr class="order-row pointer" t-att-class="{ 'highlight active bg-primary text-white': state.selectedOrder and state.selectedOrder.id === line.id }" t-on-click="() => this.onClickOrder(line)">
                                        <td class="fw-bold"><t t-esc="line.product_id[1]"/></td>
                                        <td><t t-esc="line.order_id[1]"/></td>
                                        <td><t t-esc="line.partner_id[1]"/></td>
                                        <td class="text-end fw-bold"><t t-esc="line.product_qty"/></td>
                                        <td class="text-end">
                                            <t t-esc="getDate(line.date_planned)"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <div t-if="!state.loading and state.orders.length === 0" class="text-center p-5 text-muted">
                            <i class="fa fa-folder-open-o fa-4x mb-3"/><br/>
                            No confirmed purchase order lines found.
                        </div>
                        <div t-if="state.loading" class="text-center p-5">
                            <i class="fa fa-spinner fa-spin fa-3x"/>
                        </div>
                    </div>
                </div>
                <div class="leftpane d-flex flex-column flex-grow-1 gap-2 w-100 h-100 h-lg-100 bg-view p-3">
                    <t t-if="state.selectedOrder">
                        <h5>Order Line Details</h5>
                        <div class="flex-grow-1 overflow-y-auto border rounded bg-light p-3">
                            <div class="d-flex flex-column gap-3">
                                <div>
                                    <label class="text-muted small d-block">Product</label>
                                    <span class="fs-5 fw-bold" t-esc="state.selectedOrder.product_id[1]"/>
                                </div>
                                <div class="row">
                                    <div class="col-6">
                                        <label class="text-muted small d-block">PO Reference</label>
                                        <span class="fw-bold" t-esc="state.selectedOrder.order_id[1]"/>
                                    </div>
                                    <div class="col-6 text-end">
                                        <label class="text-muted small d-block">Status</label>
                                        <span class="badge rounded-pill text-bg-success">Confirmed</span>
                                    </div>
                                </div>
                                <hr class="my-1"/>
                                <div>
                                    <label class="text-muted small d-block">Vendor</label>
                                    <span t-esc="state.selectedOrder.partner_id[1]"/>
                                </div>
                                <div class="row">
                                    <div class="col-6">
                                        <label class="text-muted small d-block">Quantity</label>
                                        <span class="fs-4 fw-bold" t-esc="state.selectedOrder.product_qty"/>
                                    </div>
                                    <div class="col-6 text-end">
                                        <label class="text-muted small d-block">Arrival</label>
                                        <span class="fw-bold" t-esc="getDate(state.selectedOrder.date_planned)"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="d-flex h-100 flex-column align-items-center justify-content-center text-muted">
                            <i class="fa fa-info-circle fa-4x mb-2"/>
                            Select an order to view details
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
